---
import { Image } from "astro:assets";
import { SOURCE_LABELS, type Entry } from "@/constants/types";
import type { HTMLAttributes } from "astro/types";
import Sticker01 from "@/assets/images/image_sticker_01.png";
import Sticker02 from "@/assets/images/image_sticker_02.png";
import SizuThumbnail from "@/assets/images/image_sizu.png";

import { format } from "date-fns";

type Props = Entry & HTMLAttributes<"article">;

const { publishedAt, url, thumbnail, title, excerpt, source } = Astro.props;
---

<a class="EntryCard" href={url} target="_blank" rel="noopener">
	<span class="EntryCard__Background"></span>
	<Image
		class="EntryCard__Sticker01"
		src={Sticker01}
		alt=""
		width={Sticker01.width}
		height={Sticker01.height}
		loading="lazy"
	/>
	<Image
		class="EntryCard__Sticker02"
		src={Sticker02}
		alt=""
		width={Sticker02.width}
		height={Sticker02.height}
		loading="lazy"
	/>
	{
		thumbnail ? (
			<Image
				class="EntryCard__Thumbnail"
				src={thumbnail}
				alt=""
				loading="lazy"
				width={800}
				height={450}
			/>
		) : source === "sizu" ? (
			<Image
				class="EntryCard__Thumbnail"
				src={SizuThumbnail}
				alt=""
				loading="lazy"
				width={SizuThumbnail.width}
				height={SizuThumbnail.height}
			/>
		) : (
			<Image
				class="EntryCard__Thumbnail"
				src="https://placehold.jp/800x450.png"
				alt=""
				loading="lazy"
				width={800}
				height={450}
			/>
		)
	}
	<div class="EntryCard__Body">
		<h3 class="EntryCard__title">{title}</h3>

		{excerpt && <p class="EntryCard__Excerpt">{excerpt}</p>}
		<time class="EntryCard__Date" datetime={publishedAt.toISOString()}>
			{format(publishedAt, "yyyy/MM/dd")}
		</time>
	</div>

	<ul class="EntryCard__labelList">
		<li># {SOURCE_LABELS[source]}</li>
	</ul>
</a>

<style>
	.EntryCard {
		position: relative;
		display: grid;
		row-gap: 1rem;
		grid-template-rows: auto 1fr;
		isolation: isolate;
		padding: 1.5rem;
		height: 100%;
		align-content: start;
	}

	.EntryCard__Sticker01 {
		position: absolute;
		top: -1.5rem;
		right: -1.5rem;
		width: 6rem;
		filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
		transform: rotate(15deg);
	}
	.EntryCard__Sticker02 {
		position: absolute;
		top: -0.5rem;
		left: -0.5rem;
		width: 6rem;
		filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
		transform: rotate(-15deg);
	}

	.EntryCard__Background {
		display: block;
		position: absolute;
		border-radius: 0.5rem;
		background-color: white;
		inset: 0;
		z-index: -1;
		box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.2);

		&::before {
			content: "";
			position: absolute;
			inset: 0.125rem;
			border: 2px solid #2f2f2f;
			border-radius: 0.5rem;
		}
	}

	.EntryCard__labelList {
		position: absolute;
		display: flex;
		gap: 0.5rem;
		bottom: 0.5rem;
		left: -0.25rem;

		li {
			border-radius: 0.5rem;
			padding: 0.25rem;
			background-color: white;
			box-shadow: 0 0.125rem 0.125rem rgba(0, 0, 0, 0.2);
			font-size: 0.75rem;
			&:nth-child(odd) {
				transform: rotate(-4deg);
			}
		}
	}

	.EntryCard__Thumbnail {
		width: 100%;
		border-radius: 0.5rem;
		aspect-ratio: 16/9;
		object-fit: cover;
	}
	.EntryCard__Body {
		display: grid;
		row-gap: 1rem;
		grid-template-rows: auto auto 1fr;
	}

	.EntryCard__Date {
		justify-self: end;
		align-self: end;
		font-size: 0.875rem;
	}
</style>
