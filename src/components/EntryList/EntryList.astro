---
import EntryCard from "@/components/EntryCard/EntryCard.astro";
import type { Entry } from "@/constants/types";

type Props = {
	entries: Entry[];
	emptyMessage?: string;
};

const { entries, emptyMessage = "まだ記事・動画がありません。" } = Astro.props;
---

{
	entries.length > 0 ? (
		<ul class="EntryList">
			{entries.map((entry) => (
				<li>
					<EntryCard {...entry} />
				</li>
			))}
		</ul>
	) : (
		<p class="EntryList__Empty">{emptyMessage}</p>
	)
}

<style>
	.EntryList {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.EntryList__Empty {
		color: #666;
	}
</style>
