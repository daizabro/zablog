---
import EntryCard from "../EntryCard/EntryCard.astro";
import type { Entry } from "../../lib/types";

type Props = {
	entries: Entry[];
	emptyMessage?: string;
};

const { entries, emptyMessage = "まだ記事・動画がありません。" } = Astro.props;
---

{
	entries.length > 0 ? (
		<ul class="entry-list">
			{entries.map((entry) => (
				<EntryCard entry={entry} />
			))}
		</ul>
	) : (
		<p class="entry-list__empty">{emptyMessage}</p>
	)
}

<style>
	.entry-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 0;
		margin: 0;
	}

	.entry-list__empty {
		color: #666;
	}
</style>
