---
import SITEMAP from "@/constants/sitemap";
---

<header class="Header">
	<div class="Header__Inner">
		<nav class="Header__Nav" aria-label="グローバル">
			<ul class="Header__List">
				{
					SITEMAP.map((section) => (
						<li>
							<a href={section.href}>{section.heading}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.Header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		z-index: 100;
	}

	.Header__Inner {
		width: var(--content-width);
		margin-inline: auto;
		padding-block: 0.5rem;
		display: grid;
		justify-content: end;
	}

	.Header__Nav {
		width: fit-content;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.5rem;
		position: relative;
		border-radius: 999px;
		background-color: rgba(255, 255, 255, 0.8);
	}

	.Header__List {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		list-style: none;

		> li {
			font-family: "Luckiest Guy", sans-serif;
			font-weight: 400;
			font-style: normal;
		}
	}
</style>
