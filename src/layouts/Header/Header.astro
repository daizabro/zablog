---
import { SECTION_LABELS, SECTIONS } from "@/lib/types";
---

<header class="Header">
	<p><a href="/">ZABLOG</a></p>
	<nav class="Header__Nav">
		<ul class="Header__List">
			{
				SECTIONS.map((section) => (
					<li>
						<a href={`/${section}`}>{SECTION_LABELS[section]}</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.Header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid #e0e0e0;
	}

	.Header__Nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.5rem;
	}

	.Header__List {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
</style>
