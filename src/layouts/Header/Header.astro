---
import SITEMAP from "@/constants/sitemap";
import { Image } from "astro:assets";
import Icon from "@/assets/images/image_sticker_01.png";
---

<header class="Header" id="Header">
	<div class="Header__Inner">
		<nav class="Header__Nav" aria-label="グローバル">
			<ul class="Header__List">
				<li>
					<a href="/"
						><Image
							src={Icon}
							alt="ZABLOG"
							width={Icon.width}
							height={Icon.height}
						/></a
					>
				</li>
				{
					SITEMAP.map((section) => (
						<li>
							<a href={section.href}>{section.heading}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	const header = document.getElementById("Header");

	if (header) {
		const updateHeaderVisibility = () => {
			header.classList.toggle(
				"is-visible",
				window.scrollY >= window.innerHeight,
			);
		};

		updateHeaderVisibility();
		document.addEventListener("scroll", updateHeaderVisibility, {
			passive: true,
		});
	}
</script>

<style>
	.Header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		z-index: 100;
		background-color: white;
		box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.1);
		transform: translateY(-100%);
		opacity: 0;
		transition:
			transform 0.3s ease,
			opacity 0.3s ease;
		pointer-events: none;

		&.is-visible {
			transform: translateY(0);
			opacity: 1;
			pointer-events: auto;
		}
	}

	.Header__Inner {
		width: var(--content-width);
		margin-inline: auto;
		display: grid;
		justify-content: end;
	}

	.Header__Nav {
		width: fit-content;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.5rem;
		position: relative;
	}

	.Header__List {
		display: flex;
		flex-wrap: wrap;
		gap: 2.25rem;
		align-items: center;

		> li {
			font-family: "Luckiest Guy", sans-serif;
			font-weight: 400;
			font-style: normal;
			font-size: 1.75rem;
		}
		img {
			width: 3.5rem;
		}
	}
</style>
