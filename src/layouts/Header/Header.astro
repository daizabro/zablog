---
import SITEMAP from "@/constants/sitemap";
---

<header class="Header">
	<div class="Header__Inner">
		<a href="/">ZABLOG</a>
		<nav class="Header__Nav" aria-label="グローバル">
			<ul class="Header__List">
				{
					SITEMAP.map((section) => (
						<li>
							<a href={section.href}>{section.heading}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.Header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		z-index: 100;
	}

	.Header__Inner {
		width: var(--content-width);
		margin-inline: auto;
		padding-block: 0.5rem;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		column-gap: 1rem;
	}

	.Header__Nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.5rem;
	}

	.Header__List {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
</style>
