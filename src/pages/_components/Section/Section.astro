---
import type { HTMLAttributes } from "astro/types";
type Props = Omit<HTMLAttributes<"section">, "class"> & {
	heading: string;
	href?: string;
	className?: string;
};
const { heading, href, className, ...restProps } = Astro.props;
---

<section class:list={["Section", className]} {...restProps}>
	<h2 class="Section__Title">{heading}</h2>
	<slot />

	{href && <a href={href}>詳しく見る</a>}
</section>

<style>
	.Section {
		padding-block: 3.5rem;
	}

	.Section__Title {
		font-family: "Limelight", sans-serif;
		margin-bottom: 3rem;
		font-size: 2rem;
	}
</style>
