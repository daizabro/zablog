---
import Container from "@/components/Container/Container.astro";
import EntryList from "@/components/EntryList/EntryList.astro";
import Layout from "@/layouts/Layout.astro";

import { getEntriesBySection } from "@/lib/entries";

const entries = await getEntriesBySection("breakin");
---

<Layout>
	<h1>Breakin'</h1>
	<Container>
		<EntryList entries={entries.map((entry) => entry.data)} />
	</Container>
</Layout>
