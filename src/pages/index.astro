---
import Hero from "@/components/Hero/Hero.astro";
import Container from "@/components/Container/Container.astro";
import Layout from "@/layouts/Layout.astro";
import Section from "./_components//Section/Section.astro";
import EntryList from "@/components/EntryList/EntryList.astro";

import { getLatestEntries } from "@/lib/entries";
import SITEMAP from "@/constants/sitemap";

const latestEntries = await getLatestEntries(3);
---

<Layout>
	<Hero />

	<Container>
		<p>
			TODO: 何か良さげな文章に差し替える<br />
			害虫駆除業務からフロントエンドエンジニアに転向。<br />
			趣味はブレイキンとスプラトゥーンです。<br />
			noteやZenn、しずかなインターネット、YouTubeに散らばっている発信をここにまとめています。
		</p>

		<Section heading="Latest Entries">
			<EntryList entries={latestEntries.map((entry) => entry.data)} />
		</Section>

		{
			SITEMAP.map((section) => (
				<Section heading={section.heading} href={section.href} />
			))
		}
	</Container>
</Layout>
