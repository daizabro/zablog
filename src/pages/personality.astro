---
import EntryList from "../components/EntryList/EntryList.astro";
import Layout from "../layouts/Layout.astro";
import { getEntriesBySection } from "../lib/entries";

const entries = await getEntriesBySection("personality");
---

<Layout title="Personality" description="ポエムや個人的な意見、イベントレポート、日記。">
	<main class="page">
		<h1>Personality</h1>
		<EntryList entries={entries.map((entry) => entry.data)} />
	</main>
</Layout>

<style>
	.page {
		max-width: 960px;
		margin-inline: auto;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
</style>
